# Example settings for s3armor.
#
# Copy this file to /etc/s3armor/env and set it to mode 0600. It can
# hold secret file paths.
#
# This list is the minimum to start s3armor. See docs/USER-GUIDE.md
# "3. Configuration reference" for every setting. Run "s3armor config"
# on a running install to see each effective value and where it came
# from.

# Backend S3 endpoint. Required.
#S3A_BACKEND_ENDPOINT=https://s3.example.com

# Backend SigV4 region. Default: us-east-1.
#S3A_BACKEND_REGION=us-east-1

# Backend access key. Required.
#S3A_BACKEND_ACCESS_KEY=

# Backend secret key, read from a file. Required. Do not set both
# S3A_BACKEND_SECRET_KEY and S3A_BACKEND_SECRET_KEY_FILE; that is a
# fatal startup error.
#S3A_BACKEND_SECRET_KEY_FILE=/etc/s3armor/backend-secret-key

# Name of the master key used for new writes. Required.
#S3A_KEY_ACTIVE=K1

# Master key K1, read from a file. Required (at least the active key).
#
# On the Debian package, the systemd unit sets this through
# LoadCredential and ignores this line — leave it commented out there.
# On the Alpine package, OpenRC has no LoadCredential, so point this at
# the key file directly:
#S3A_KEY_K1_FILE=/etc/s3armor/master.key
